<%
const isForm = currentUser.role === 'admin' && (edit || query.tab === 'form');
const goal = edit || {};
const brl = (value) => Number(value || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const selected = (actual, expected) => String(actual ?? '') === String(expected) ? 'selected' : '';
const goalSellers = [...new Map(goalOptions.filter((item) => item.sellerId).map((item) => [String(item.sellerId), item.sellerName])).entries()].sort((a,b) => a[1].localeCompare(b[1], 'pt-BR'));
const goalPeriods = [...new Map(goalOptions.map((item) => [String(item.periodId), item.periodName])).entries()].sort((a,b) => a[1].localeCompare(b[1], 'pt-BR'));
%>
<header class="page-header">
  <div>
    <h1>Metas</h1>
    <p>Cadastre, visualize e gerencie as metas do sistema.</p>
  </div>
</header>

<section class="admin-card management-hub goals-hub">
  <nav class="tabs" aria-label="Se&ccedil;&otilde;es de metas">
    <a class="tab <%= !isForm ? 'is-active' : '' %>" aria-current="<%= !isForm ? 'page' : 'false' %>" href="/goals">Lista de Metas</a>
    <% if (currentUser.role === 'admin') { %>
      <a class="tab <%= isForm ? 'is-active' : '' %>" aria-current="<%= isForm ? 'page' : 'false' %>" href="/goals?tab=form"><%= edit ? 'Editar Meta' : 'Cadastrar Meta' %></a>
    <% } %>
  </nav>

  <% if (isForm) { %>
    <section class="form-panel goals-form-panel" aria-labelledby="goal-form-title">
      <div class="goals-panel-heading">
        <div>
          <h2 id="goal-form-title"><%= edit ? 'Editar Meta' : 'Cadastrar Meta' %></h2>
          <p><%= edit ? 'Atualize os dados da meta selecionada.' : 'Preencha os dados para cadastrar uma nova meta.' %></p>
        </div>
      </div>

      <form method="post" action="<%= edit ? '/goals/' + edit.id : '/goals' %>" id="goal-form" class="goal-form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <fieldset class="goal-form-section">
          <legend>Escopo da meta</legend>
          <div class="goal-scope-grid">
            <label for="goal-type">Tipo da Meta
              <select id="goal-type" name="goal_type" required>
                <option value="general" <%= selected(goal.goal_type || 'general', 'general') %>>Meta em grupo</option>
                <option value="individual" <%= selected(goal.goal_type, 'individual') %>>Meta individual</option>
              </select>
            </label>
            <label for="goal-period">Per&iacute;odo
              <select id="goal-period" name="goal_period_id" required>
                <option value="">Selecione</option>
                <% refs.periods.forEach((period) => { %>
                  <option value="<%= period.id %>" data-code="<%= period.code %>" <%= selected(goal.goal_period_id, period.id) %>><%= period.name %></option>
                <% }) %>
              </select>
            </label>
            <% if (edit) { %>
              <label class="seller-goal-field" for="goal-seller">Vendedora
                <select id="goal-seller" name="seller_id">
                  <option value="">Selecione</option>
                  <% refs.sellers.forEach((seller) => { %>
                    <option value="<%= seller.id %>" <%= selected(goal.seller_id, seller.id) %>><%= seller.full_name %><%= seller.is_active ? '' : ' (inativa)' %></option>
                  <% }) %>
                </select>
              </label>
            <% } else { %>
              <fieldset class="seller-goal-field goal-seller-picker" aria-describedby="goal-seller-help">
                <legend>Vendedoras</legend>
                <p id="goal-seller-help">Selecione uma ou mais. Cada vendedora receberá uma meta própria de mesmo valor e período.</p>
                <div class="goal-seller-options">
                  <% refs.sellers.forEach((seller) => { %>
                    <label class="goal-seller-choice"><input type="checkbox" name="seller_ids" value="<%= seller.id %>"><span><%= seller.full_name %></span></label>
                  <% }) %>
                </div>
              </fieldset>
            <% } %>
          </div>
        </fieldset>

        <fieldset class="goal-form-section">
          <legend>Valor e vig&ecirc;ncia</legend>
          <div class="goal-total-grid">
            <label for="goal-value">Valor da meta
              <input id="goal-value" type="number" name="goal_value" min="0.01" step="0.01" inputmode="decimal" value="<%= goal.goal_value ?? '' %>" required>
            </label>
            <label for="goal-start-date">Data Inicial
              <input id="goal-start-date" type="date" name="start_date" value="<%= goal.start_date || '' %>" required>
            </label>
            <label for="goal-end-date">Data Final
              <input id="goal-end-date" type="date" name="end_date" value="<%= goal.end_date || '' %>" required>
            </label>
          </div>
          <p class="goal-total-help">Vendas da base contam 50% do valor para a meta; as demais contam 100%.</p>
        </fieldset>

        <div class="form-actions goal-form-actions">
          <a class="button button-secondary" href="/goals">Cancelar</a>
          <button type="submit"><%= edit ? 'Atualizar' : 'Salvar' %></button>
        </div>
      </form>
    </section>
  <% } else { %>
    <section class="list-panel goals-list-panel" aria-labelledby="goals-list-title">
      <div class="section-heading">
        <div>
          <h2 id="goals-list-title">Lista de Metas</h2>
          <p>Gerencie os registros cadastrados.</p>
        </div>
        <button class="button button-secondary filter-toggle" type="button" aria-expanded="<%= Object.keys(query).some((key) => key !== 'page') %>" aria-controls="goal-filters"><%= Object.keys(query).some((key) => key !== 'page') ? 'Ocultar filtros' : 'Mostrar filtros' %></button>
      </div>

      <form id="goal-filters" method="get" class="filter-panel filter-panel--goals <%= Object.keys(query).some((key) => key !== 'page') ? 'is-open' : '' %>">
        <label for="filter-goal-type">Tipo
          <select id="filter-goal-type" name="goal_type">
            <option value="">Todos</option>
            <option value="general" <%= selected(query.goal_type, 'general') %>>Meta em grupo</option>
            <option value="individual" <%= selected(query.goal_type, 'individual') %>>Meta individual</option>
          </select>
        </label>
        <label for="filter-goal-seller">Vendedora da meta
          <select id="filter-goal-seller" name="seller_id">
            <option value="">Todas</option>
            <% goalSellers.forEach(([id, name]) => { %><option value="<%= id %>" <%= selected(query.seller_id, id) %>><%= name %></option><% }) %>
          </select>
        </label>
        <label for="filter-goal-period">Periodicidade
          <select id="filter-goal-period" name="goal_period_id">
            <option value="">Todas</option>
            <% goalPeriods.forEach(([id, name]) => { %><option value="<%= id %>" <%= selected(query.goal_period_id, id) %>><%= name %></option><% }) %>
          </select>
        </label>
        <label for="filter-goal-start">Meta vigente a partir de
          <input id="filter-goal-start" type="date" name="start_date" value="<%= query.start_date || '' %>">
        </label>
        <label for="filter-goal-end">Meta vigente até
          <input id="filter-goal-end" type="date" name="end_date" value="<%= query.end_date || '' %>">
        </label>
        <label>Meta específica
          <select name="goal_id" aria-describedby="goal-options-feedback">
            <option value="">Todas as metas</option>
            <% goalOptions.forEach((item) => { %><option value="<%=item.id%>" data-goal-type="<%=item.type%>" data-seller-id="<%=item.sellerId%>" data-period-id="<%=item.periodId%>" data-start="<%=item.start%>" data-end="<%=item.end%>" <%=selected(query.goal_id,item.id)%>><%=item.label%></option><% }) %>
          </select><small id="goal-options-feedback" data-goal-options-feedback aria-live="polite"></small>
        </label>
        <div class="filter-actions">
          <a class="button button-ghost" href="/goals">Limpar</a>
          <button type="submit">Filtrar</button>
        </div>
      </form>

      <div class="table-scroll">
        <table class="data-table goals-table">
          <thead><tr><th>ID</th><th>Tipo</th><th>Per&iacute;odo</th><th>Vendedora</th><th>Valor</th><th>In&iacute;cio</th><th>Fim</th><th>A&ccedil;&otilde;es</th></tr></thead>
          <tbody>
            <% if (!result.items.length) { %>
              <tr><td class="empty-cell" colspan="8">Nenhuma meta encontrada para os filtros aplicados.</td></tr>
            <% } %>
            <% result.items.forEach((item) => { %>
              <tr>
                <td><%= item.id %></td>
                <td><span class="status-badge <%= item.goal_type === 'general' ? 'goal-general' : 'goal-individual' %>"><%= item.goal_type === 'general' ? 'Em grupo' : 'Individual' %></span></td>
                <td><%= item.period_name %></td>
                <td><% if (item.seller_name) { %><%= item.seller_name %><% } else { %>&mdash;<% } %></td>
                <td><strong><%= brl(item.goal_value) %></strong></td>
                <td><%= item.start_date %></td>
                <td><%= item.end_date %></td>
                <td><div class="row-actions"><% if (currentUser.role === 'admin') { %><a class="button button-secondary" href="/goals/<%= item.id %>/edit">Editar</a><form method="post" action="/goals/<%= item.id %>/delete" data-confirm="Excluir esta meta?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger" type="submit">Excluir</button></form><% } %></div></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="pagination-summary">P&aacute;gina <%= result.pagination.page %> de <%= result.pagination.pages %> &middot; <%= result.pagination.total %> meta(s).</p>
    </section>
  <% } %>
</section>
