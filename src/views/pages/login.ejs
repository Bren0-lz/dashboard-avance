<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> — Dashboard Avance</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  <script src="/assets/js/login.js" defer></script>
</head>
<body>
  <main class="center-card">
    <h1>Dashboard Avance</h1>
    <p>Entre para continuar.</p>
    <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <label>E-mail<input name="email" type="email" required autocomplete="username" maxlength="191"></label>
      <div class="login-password-group">
        <label for="login-password">Senha</label>
        <div class="login-password-field">
          <input id="login-password" name="password" type="password" required autocomplete="current-password" maxlength="200">
          <button type="button" class="login-password-toggle" aria-controls="login-password" aria-pressed="false">Mostrar senha</button>
        </div>
      </div>
      <button type="submit">Entrar</button>
    </form>
  </main>
</body>
</html>
